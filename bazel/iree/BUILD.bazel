"""IREE integration: source module (`@iree_core`) + pinned prebuilt wheels.

- Source: `bazel_dep` + `git_override` on `iree_core` (see MODULE.bazel) —
  in-process runtime C API (`:runtime_cc`).
- Wheels: manylinux `iree-compile` / `iree-run-module` / `libIREECompiler.so`
  for compile + HAL discovery (`--dump_devices`). Wheels remain even while the
  source runtime is linked: the CLI tools are not produced by `:runtime_cc`.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# In-process C runtime API built from @iree_core (git_override).
alias(
    name = "runtime_cc",
    actual = "@iree_core//runtime/src/iree/runtime:runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "hal_drivers",
    actual = "@iree_core//runtime/src/iree/hal/drivers",
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "compiler_libs",
    actual = select({
        "@platforms//cpu:x86_64": "@iree_compiler_linux_x86_64//:compiler_libs",
        "@platforms//cpu:aarch64": "@iree_compiler_linux_aarch64//:compiler_libs",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "runtime_libs",
    actual = select({
        "@platforms//cpu:x86_64": "@iree_runtime_linux_x86_64//:runtime_libs",
        "@platforms//cpu:aarch64": "@iree_runtime_linux_aarch64//:runtime_libs",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "iree-compile",
    actual = select({
        "@platforms//cpu:x86_64": "@iree_compiler_linux_x86_64//:iree-compile",
        "@platforms//cpu:aarch64": "@iree_compiler_linux_aarch64//:iree-compile",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "iree-run-module",
    actual = select({
        "@platforms//cpu:x86_64": "@iree_runtime_linux_x86_64//:iree-run-module",
        "@platforms//cpu:aarch64": "@iree_runtime_linux_aarch64//:iree-run-module",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "libIREECompiler",
    actual = select({
        "@platforms//cpu:x86_64": "@iree_compiler_linux_x86_64//:libIREECompiler",
        "@platforms//cpu:aarch64": "@iree_compiler_linux_aarch64//:libIREECompiler",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

# Aggregate runfiles package for Rust crates that shell out to both tools.
filegroup(
    name = "tools",
    srcs = [
        ":compiler_libs",
        ":runtime_libs",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_binary(
    name = "iree_compile_bin",
    srcs = ["iree_compile_wrapper.sh"],
    data = [":compiler_libs"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "iree_tools_smoke",
    srcs = ["iree_tools_smoke.sh"],
    data = [":tools"],
    target_compatible_with = ["@platforms//os:linux"],
)
