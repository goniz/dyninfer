load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs:rules_rust_bindgen.bzl", "rust_bindgen")

package(default_visibility = ["//visibility:public"])

rust_bindgen(
    name = "mlir_bindings",
    header = "//third_party/mlir_c_api:wrapper.h",
    cc_lib = "//third_party/mlir_c_api:headers",
    bindgen_flags = [
        "--allowlist-function=mlir.*",
        "--allowlist-function=ireeCompilerRegisterDialects",
        "--allowlist-function=ireeCompilerInitializeContext",
        "--allowlist-function=ireeCompilerSessionBorrowContext",
        "--allowlist-function=ireeCompilerSessionStealContext",
        "--allowlist-function=ireeCompilerInvocationImport.*",
        "--allowlist-function=ireeCompilerInvocationExportStealModule",
        "--allowlist-type=Mlir.*",
        "--allowlist-var=MLIR_.*",
        "--default-enum-style=rust",
        "--no-layout-tests",
        "--ctypes-prefix=::core::ffi",
        "--use-core",
    ],
)

rust_library(
    name = "dyninfer-mlir-sys",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dyninfer_mlir_sys",
    edition = "2024",
    aliases = aliases(),
    compile_data = [":mlir_bindings"],
    rustc_env = {
        "DYNINFER_MLIR_BINDINGS": "$(execpath :mlir_bindings)",
    },
    rustc_flags = ["--cfg=bazel"],
    data = ["//bazel/iree:compiler_libs"],
    deps = all_crate_deps(normal = True) + [
        "//bazel/iree:libIREECompiler",
    ],
)

rust_test(
    name = "dyninfer-mlir-sys_tests",
    crate = ":dyninfer-mlir-sys",
    compile_data = [":mlir_bindings"],
    rustc_env = {
        "DYNINFER_MLIR_BINDINGS": "$(execpath :mlir_bindings)",
    },
    data = ["//bazel/iree:compiler_libs"],
    deps = all_crate_deps(normal_dev = True),
)
