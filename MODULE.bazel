"""Dynamic Inference Engine Bazel module."""

module(
    name = "dyninfer",
    version = "0.1.0",
)

bazel_dep(name = "rules_rs", version = "0.0.101")
bazel_dep(name = "llvm", version = "0.8.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

toolchains = use_extension(
    "@rules_rs//rs/toolchains:module_extension.bzl",
    "toolchains",
)
toolchains.toolchain(
    edition = "2024",
    # Keep in sync with Cargo.toml workspace rust-version (latest stable).
    version = "1.97.1",
)
use_repo(toolchains, "default_rust_toolchains")

# Optional facade so existing @rules_rust labels resolve through rules_rs.
rules_rust = use_extension(
    "@rules_rs//rs:rules_rust.bzl",
    "rules_rust",
)
use_repo(rules_rust, "rules_rust")

# Hermetic bindgen prebuilts (rules_rs) for IREE / C ABI headers.
rules_rust_bindgen = use_extension(
    "@rules_rs//rs:rules_rust_bindgen.bzl",
    "rules_rust_bindgen",
)
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
    "@rules_rust_bindgen//:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# ---------------------------------------------------------------------------
# IREE source module (`iree_core`) — runtime (and optionally compiler) built
# from the pinned git commit via bzlmod. Submodules are fetched recursively.
# A small patch remaps third_party paths so they resolve inside @iree_core
# when dyninfer is the root module (upstream assumes IREE is root).
# See bazel/iree/SOURCE.md.
# ---------------------------------------------------------------------------
bazel_dep(name = "iree_core", version = "0.0.1")

git_override(
    module_name = "iree_core",
    remote = "https://github.com/iree-org/iree.git",
    commit = "e4a3b0405d7d23554da26403658d0e8c3c5ecf25",
    recursive_init_submodules = True,
    patches = [
        "//bazel/iree/patches:iree_downstream_extension.patch",
        "//bazel/iree/patches:iree_flatcc_downstream.patch",
    ],
    patch_strip = 1,
)

# LLVM overlay must be supplied by the root (IREE's own local_path_override is
# ignored when iree_core is not the root module). Pin matches IREE's
# third_party/llvm-project submodule at e4a3b040.
bazel_dep(name = "llvm-project-overlay", version = "main")

archive_override(
    module_name = "llvm-project-overlay",
    urls = [
        "https://github.com/iree-org/llvm-project/archive/66395ad94c3283d938a2957e7c7b439711764680.tar.gz",
    ],
    integrity = "sha256-zfmjPfi9F/jEiqG1RfsY9CE1mY8+dwGixN34bsA8W+0=",
    strip_prefix = "llvm-project-66395ad94c3283d938a2957e7c7b439711764680/utils/bazel",
)

# ---------------------------------------------------------------------------
# IREE prebuilt wheels — still required alongside `@iree_core`:
#   - `libIREECompiler` / `iree-compile` — in-process + CLI compile path
#   - `iree-run-module` — HAL `--dump_devices` discovery and tool-backed invoke
# `@iree_core` builds the in-process *runtime C library* (`//bazel/iree:runtime_cc`);
# it does not replace the wheel CLI tools or the compiler shared library yet.
# ---------------------------------------------------------------------------
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# TheRock 7.14 SDK for the project's initial Strix Halo (gfx1151) target.
# The release is pinned by URL and digest so ROCm compiler/runtime inputs do
# not depend on packages installed on the host. See bazel/therock/README.md.
http_archive(
    name = "therock_rocm_gfx1151",
    urls = [
        "https://rocm.nightlies.amd.com/tarball-multi-arch/therock-dist-linux-gfx1151-7.14.0a20260624.tar.gz",
    ],
    sha256 = "2c2720860f1e2f6caa8d926a6b6abc8d041d0f0f255bbf1de2a1b405eb68fe29",
    build_file = "//bazel/therock:therock.BUILD.bazel",
)

